# CareerPilot — Configuração Local de Exemplo (APENAS VALORES FICTÍCIOS / DUMMY)
# Copie para .env apenas se desejar personalizar configurações locais.
# NUNCA faça commit de .env, tokens OAuth, chaves de API reais ou dados pessoais (CPF/RG/endereço).

CAREERPILOT_ENV=development
CAREERPILOT_HOST=127.0.0.1
CAREERPILOT_PORT=8000

# Autenticação local do painel (usuário único em loopback)
CAREERPILOT_PASSCODE=demo-local-2026
CAREERPILOT_SESSION_SECRET=change-me-local-dev-secret-only

# Banco SQLite (WAL habilitado automaticamente)
DATABASE_URL=sqlite:///./data/real/careerpilot.db
ARTIFACTS_DIR=./data/real/artifacts

# Provedor LLM (ollama local, openai_compat, ou offline determinístico)
LLM_PROVIDER=offline
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=
LLM_DAILY_BUDGET_USD=1.00
LLM_ALLOW_REMOTE_PROFILE=false
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONTEXT_CHARS=24000

# Navegador visível via Chrome DevTools Protocol (sempre em loopback)
BROWSER_CDP_URL=http://127.0.0.1:9222
# Diretório persistente opcional para sessão Chrome (padrão: data/real/chrome-profile)
# CAREERPILOT_CHROME_PROFILE_DIR=./data/real/chrome-profile

# Notificações opcionais (padrão = local_outbox)
NOTIFICATION_CHANNEL=local_outbox
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Gmail API OAuth opcional (Desktop flow; nunca incluir CPF/RG/endereço em e-mails)
GMAIL_CLIENT_SECRETS_PATH=
GMAIL_TOKEN_PATH=
